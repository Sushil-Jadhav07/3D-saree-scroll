# NOOLAM — Hostinger (LiteSpeed/Apache) config
# Lives in /public so `npm run build` copies it into dist/.

Options -Indexes

# ---- Force HTTPS -------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---- Compression -------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/ttf
</IfModule>

# ---- MIME types --------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType video/mp4 .mp4
</IfModule>

# ---- Caching -----------------------------------------------------------
# Default: browser must revalidate (ETag) so a replaced file shows up fast.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Images / video keep their filename between deploys -> short cache + revalidate.
  # (When you swap an image, ALSO rename it, e.g. mood-0-v3.webp, to bypass any CDN cache.)
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|mp4)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
</IfModule>

# Vite emits content-hashed files in /assets (index-AbC123.js) -> safe to cache for a year.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# ---- Security headers --------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
